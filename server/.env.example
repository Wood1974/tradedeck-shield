SHIELD_DATABASE_URL=sqlite:///./shield.db
SHIELD_STORAGE_ROOT=./storage
# Explicit launch platforms. Android requires its production credentials before enabling.
SHIELD_ENABLED_PLATFORMS=ios
# Standalone production identity. Generate a random 32+ byte secret and keep it private.
SHIELD_API_AUTH_MODE=local
SHIELD_AUTHZ_MODE=local
SHIELD_LOCAL_JWT_SECRET=
SHIELD_CHALLENGE_TTL_SECONDS=120
SHIELD_ATTESTATION_MODE=development
SHIELD_APP_ID=YOUR_TEAM_ID.com.yourcompany.shield
SHIELD_SUPABASE_URL=
SHIELD_SUPABASE_SERVICE_ROLE_KEY=
SHIELD_BUCKET=shield-photos
SHIELD_PLAY_INTEGRITY_MODE=development
SHIELD_PLAY_PACKAGE_NAME=com.tradedeck.shield
SHIELD_PLAY_MAX_TOKEN_AGE_SECONDS=300
SHIELD_PLAY_REQUIRE_LICENSED=false
SHIELD_PLAY_REQUIRE_DEVICE_INTEGRITY=true
SHIELD_PLAY_REQUIRE_STRONG_INTEGRITY=false
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Section 5 — Shield API authority
# Legacy integration mode can still use SUPABASE_URL with SHIELD_API_AUTH_MODE=production.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SHIELD_JWKS_CACHE_SECONDS=600
SHIELD_MAX_PHOTO_BYTES=15728640

# Section 8 location intelligence
SHIELD_LOCATION_MAX_AGE_SECONDS=120
SHIELD_LOCATION_MAX_ACCURACY_M=100
SHIELD_LOCATION_CONSISTENT_RADIUS_M=200
SHIELD_LOCATION_REJECT_RADIUS_M=2000
